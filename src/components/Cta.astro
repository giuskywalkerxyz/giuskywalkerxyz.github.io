---
import { bookingHref, mailto } from '../site';
import { langOf, lp, useT } from '../i18n';
const lang = langOf(Astro.url.pathname);
const t = useT(lang);
---
<section class="cta" aria-labelledby="cta-h">
  <div>
    <p class="kicker">{t('cta.kicker')}</p>
    <h2 id="cta-h" set:html={t('cta.h')} />
    <p>{t('cta.p')}</p>
  </div>
  <div class="btnrow">
    <a class="btn btn--primary" href={lp(lang, '/pentest/#scope')}>{t('cta.scope')}</a>
    <a class="btn" href={bookingHref(lang)}>{t('cta.book')}</a>
    <a class="btn" href={mailto(t('mail.inquiry'))}>{t('cta.email')}</a>
  </div>
</section>
