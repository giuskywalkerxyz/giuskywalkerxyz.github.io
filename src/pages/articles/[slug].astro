---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { fmtDate } from '../../site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', (e) => !e.data.draft);
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} active="articles" description={d.summary}>
  <article class="article">
    <header class="article__head">
      <p class="kicker">cat articles/{entry.id}.md</p>
      <h1>{d.title}</h1>
      <div class="article__meta">
        <span class="tag">{fmtDate(d.date)}</span>
        {d.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>
    <div class="prose"><Content /></div>
    <p class="article__back"><a class="textlink" href="/articles/">← All articles</a></p>
  </article>
</Base>
