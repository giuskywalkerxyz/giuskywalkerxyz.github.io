---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const certs = (await getCollection('certifications')).sort((a, b) => a.data.order - b.data.order);
const earned = certs.filter((c) => c.data.status === 'earned');
const inProgress = certs.filter((c) => c.data.status === 'in-progress');
const issuers = [...new Set(earned.map((c) => c.data.issuer))];

const fmt = (d?: Date) =>
  d ? d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' }) : undefined;
---
<Base title="Certifications" active="certs" description="Offensive security certifications held by Giulliano Amaral.">
  <header class="pagehead">
    <p class="kicker">ls ~/certs</p>
    <h1>Certifications</h1>
    <p class="lede">
      {earned.length} practical, lab-based certifications from {issuers.length} {issuers.length === 1 ? 'issuer' : 'issuers'}, covering
      pentest, red team, Active Directory, web, API and AI security. Each links to its public verification page where one exists.
    </p>
  </header>

  <div class="certgrid">
    {earned.map((c) => (
      <article class="cert" id={c.id}>
        <div class="cert__top">
          <span class="cert__code">{c.data.code}</span>
          <span class="tag">{c.data.track}</span>
        </div>
        <h2 class="cert__name">{c.data.name}</h2>
        <p class="cert__issuer">{c.data.issuer}{fmt(c.data.issued) && <> · {fmt(c.data.issued)}</>}</p>
        <p class="cert__summary">{c.data.summary}</p>
        <div class="cert__skills">{c.data.skills.map((s) => <span class="tag">{s}</span>)}</div>
        {(c.data.verifyUrl || c.data.credentialId) && (
          <div class="cert__foot">
            <span class="muted">{c.data.credentialId && <>ID {c.data.credentialId.slice(0, 12)}…</>}</span>
            {c.data.verifyUrl && <a href={c.data.verifyUrl} target="_blank" rel="noopener">Verify ↗</a>}
          </div>
        )}
      </article>
    ))}
  </div>

  {inProgress.length > 0 && (
    <section class="section">
      <div class="section__head"><div><p class="kicker">ls ~/certs/in-progress</p><h2>In <em>progress</em></h2></div></div>
      <div class="certgrid">
        {inProgress.map((c) => (
          <article class="cert cert--wip" id={c.id}>
            <div class="cert__top"><span class="cert__code">{c.data.code}</span><span class="tag">in progress</span></div>
            <h2 class="cert__name">{c.data.name}</h2>
            <p class="cert__issuer">{c.data.issuer}</p>
            <p class="cert__summary">{c.data.summary}</p>
          </article>
        ))}
      </div>
    </section>
  )}
</Base>
