---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { fmtDate } from '../../site';

export async function getStaticPaths() {
  const cves = await getCollection('cves', (e) => !e.data.draft);
  return cves.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={`${d.cve}: ${d.title}`} active="cves" description={d.summary}>
  <article class="article">
    <header class="article__head">
      <p class="kicker">disclosure · {d.cve}</p>
      <h1>{d.title}</h1>
      <div class="article__meta">
        <span class={`badge badge--${d.severity.toLowerCase()}`}>{d.severity}{d.cvss && ` · ${d.cvss}`}</span>
        {d.cwe.map((w) => <span class="tag">{w}</span>)}
        {d.credited && <span class="tag">credited</span>}
        <span class="tag">{fmtDate(d.date)}</span>
      </div>
    </header>

    <table class="specs">
      <tbody>
        <tr><th>CVE</th><td>{d.cve}</td></tr>
        {d.ghsa && <tr><th>GHSA</th><td>{d.ghsa}</td></tr>}
        <tr><th>Vendor / product</th><td>{d.vendor} / {d.product}</td></tr>
        <tr><th>Class</th><td>{d.cwe.join(' · ')}</td></tr>
        {d.cvssVector && <tr><th>CVSS 3.1</th><td>{d.cvss} · <code>{d.cvssVector}</code></td></tr>}
        {d.advisoryUrl && <tr><th>Advisory</th><td><a href={d.advisoryUrl}>{d.advisoryUrl}</a></td></tr>}
      </tbody>
    </table>

    <div class="prose"><Content /></div>
    <p class="article__back"><a class="textlink" href="/cves/">← All disclosures</a></p>
  </article>
</Base>
