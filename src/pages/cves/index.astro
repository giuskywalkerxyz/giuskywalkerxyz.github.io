---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { byDateDesc } from '../../lib/sortByDate';

const cves = (await getCollection('cves', (e) => !e.data.draft)).sort(byDateDesc);
---
<Base title="Disclosures" active="cves" description="Vulnerabilities found and responsibly disclosed in open-source software.">
  <header class="pagehead">
    <p class="kicker">cat disclosures.log</p>
    <h1>Disclosed <em>vulnerabilities</em></h1>
    <p class="lede">
      Vulnerabilities I found and reported to open-source maintainers. Each entry is published only
      after the upstream advisory is public.
    </p>
  </header>

  <div class="rows">
    {cves.map((c) => (
      <a class="row" href={`/cves/${c.id}/`}>
        <span class="row__date">{c.data.cve}</span>
        <div><div class="row__title">{c.data.title}</div><p class="row__summary">{c.data.summary}</p></div>
        <div class="row__meta">
          <span class={`badge badge--${c.data.severity.toLowerCase()}`}>{c.data.severity}</span>
          <span class="tag">{c.data.vendor} / {c.data.product}</span>
          {c.data.cwe.slice(0, 1).map((w) => <span class="tag">{w}</span>)}
        </div>
      </a>
    ))}
    {cves.length === 0 && <p class="empty">Advisories pending publication.</p>}
  </div>
</Base>
