---
import Base from '../layouts/Base.astro';
import AttackGraph from '../components/AttackGraph.astro';
import Cta from '../components/Cta.astro';
import { getCollection } from 'astro:content';
import { byDateDesc } from '../lib/sortByDate';
import { bookingHref, fmtDate } from '../site';

const pub = (await getCollection('writeups', (e) => !e.data.draft)).map((e) => ({ ...e, locked: false }));
const prot = (await getCollection('protectedWriteups', (e) => !e.data.draft)).map((e) => ({ ...e, locked: true }));
const writeups = [...pub, ...prot].sort(byDateDesc);
const ai = (await getCollection('ai', (e) => !e.data.draft)).sort(byDateDesc);
const articles = (await getCollection('articles', (e) => !e.data.draft)).sort(byDateDesc);
const cves = (await getCollection('cves', (e) => !e.data.draft)).sort(byDateDesc);
const certs = (await getCollection('certifications', (c) => c.data.status === 'earned')).sort(
  (a, b) => a.data.order - b.data.order
);

const stats = [
  { n: certs.length, l: 'offensive certifications' },
  { n: writeups.length, l: 'machine writeups' },
  { n: ai.length, l: 'AI red-team labs solved' },
  { n: articles.length, l: 'research articles' },
];

const services = [
  {
    t: 'Web & API pentest',
    d: 'Manual testing of web applications and APIs, beyond what scanners report: access control, business logic and the way components chain together.',
    i: ['OWASP Top 10 / API Top 10', 'Authn, authz & IDOR', 'Business-logic abuse'],
  },
  {
    t: 'Internal & Active Directory',
    d: 'Assume-breach assessments that start from a foothold and map the realistic path to domain compromise.',
    i: ['AD attack paths', 'Credential & Kerberos abuse', 'Lateral movement'],
  },
  {
    t: 'AI / LLM red teaming',
    d: 'Adversarial testing of LLM apps and agents: prompt injection, tool abuse and trust boundaries between agents.',
    i: ['OWASP LLM Top 10', 'Agent & MCP tool abuse', 'Data-exfiltration paths'],
  },
];

const htbRows = writeups.slice(0, 3).map((w) => ({ href: `/writeups/${w.id}/`, date: w.data.date, title: w.data.machine, summary: w.data.summary, tags: [w.data.platform, w.data.difficulty, w.locked ? 'sealed' : 'retired'] }));
const aiRows = ai.slice(0, 2).map((w) => ({ href: `/ai/${w.id}/`, date: w.data.date, title: w.data.title, summary: w.data.summary, tags: ['AI/LLM', w.data.severity] }));
const latest = [...htbRows, ...aiRows].sort((a, b) => +b.date - +a.date || a.title.localeCompare(b.title));
---
<Base active="home">
  <section class="hero">
    <div class="hero__grid">
      <AttackGraph />
      <div>
        <p class="hero__prompt">$ whoami<span class="cursor" aria-hidden="true"></span></p>
        <h1>I break in, <em>so others can't.</em></h1>
        <p class="hero__roles">Pentest<span>/</span>Red team<span>/</span>Offensive security<span>/</span>Vuln research</p>
        <p class="hero__lede">
          I'm Giulliano Amaral, a penetration tester and security researcher. I find the paths an attacker
          would take through your applications, networks and AI systems, then document them clearly enough
          for your team to close them.
        </p>
        <div class="btnrow">
          <a class="btn btn--primary" href="/pentest/#scope">Scope a pentest</a>
          <a class="btn" href={bookingHref()}>Book a call</a>
          <a class="textlink" href="/writeups/">or read the writeups</a>
        </div>
      </div>
    </div>
    <div class="hero__foot">
      <span>Web · APIs · Active Directory · AI/LLM · OSS vulnerability research</span>
      <span class="muted">// authorized adversary</span>
    </div>
  </section>

  <section class="stats" aria-label="At a glance">
    {stats.map((s) => (
      <div class="stat"><div class="stat__n">{s.n}</div><div class="stat__l">{s.l}</div></div>
    ))}
  </section>

  <section class="section" id="services">
    <div class="section__head">
      <div>
        <p class="kicker">cat services.txt</p>
        <h2>What I <em>test</em></h2>
        <p>Every engagement is manual, scoped in writing, and ends with a report your developers can act on: reproducible steps, impact and fixes.</p>
      </div>
      <a class="btn btn--ghost" href="/pentest/">How engagements work</a>
    </div>
    <div class="services">
      {services.map((s, i) => (
        <article class="service">
          <div class="service__n">0{i + 1}</div>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
          <ul>{s.i.map((x) => <li>{x}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  {cves.length > 0 && (
    <section class="section" id="disclosures">
      <div class="section__head">
        <div>
          <p class="kicker">cat disclosures.log</p>
          <h2>Disclosed <em>vulnerabilities</em></h2>
        </div>
        <a class="btn btn--ghost" href="/cves/">All disclosures</a>
      </div>
      <div class="rows">
        {cves.map((c) => (
          <a class="row" href={`/cves/${c.id}/`}>
            <span class="row__date">{c.data.cve}</span>
            <div><div class="row__title">{c.data.title}</div><p class="row__summary">{c.data.vendor} / {c.data.product}</p></div>
            <div class="row__meta"><span class={`badge badge--${c.data.severity.toLowerCase()}`}>{c.data.severity}</span></div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="section" id="writeups">
    <div class="section__head">
      <div>
        <p class="kicker">ls -t writeups/</p>
        <h2>Recent <em>writeups</em></h2>
        <p>End-to-end attack chains from HackTheBox machines and AI red-team labs. Active machines stay sealed until they retire.</p>
      </div>
      <a class="btn btn--ghost" href="/writeups/">All writeups</a>
    </div>
    <div class="rows">
      {latest.map((w) => (
        <a class="row" href={w.href}>
          <span class="row__date">{fmtDate(w.date)}</span>
          <div><div class="row__title">{w.title}</div><p class="row__summary">{w.summary}</p></div>
          <div class="row__meta">{w.tags.map((t) => <span class="tag">{t}</span>)}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="section" id="articles">
    <div class="section__head">
      <div>
        <p class="kicker">ls articles/</p>
        <h2>Research &amp; <em>articles</em></h2>
      </div>
      <a class="btn btn--ghost" href="/articles/">All articles</a>
    </div>
    <div class="rows">
      {articles.slice(0, 4).map((a) => (
        <a class="row" href={`/articles/${a.id}/`}>
          <span class="row__date">{fmtDate(a.data.date)}</span>
          <div><div class="row__title">{a.data.title}</div><p class="row__summary">{a.data.summary}</p></div>
          <div class="row__meta">{a.data.tags.slice(0, 2).map((t) => <span class="tag">{t}</span>)}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="section" id="certs">
    <div class="section__head">
      <div>
        <p class="kicker">ls ~/certs</p>
        <h2>Certifications</h2>
        <p>Hands-on, lab-based exams covering pentest, red team, Active Directory, web, API and AI security.</p>
      </div>
      <a class="btn btn--ghost" href="/certs/">Details</a>
    </div>
    <div class="certstrip">
      {certs.map((c) => <a href={`/certs/#${c.id}`} title={c.data.name}>{c.data.code}</a>)}
    </div>
  </section>

  <Cta />
</Base>
