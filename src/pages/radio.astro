---
import Base from '../layouts/Base.astro';
import RadioConsole from '../components/RadioConsole.astro';
---
<Base
  title="imperial holonet — giuskywalker.sh"
  active="radio"
  description="Imperial HoloNet Radio — original synthesised Imperial ambience, an Imperial march, and encrypted transmissions."
>
  <section class="article__head" style="padding-top:36px;">
    <p class="article__kicker">// encrypted frequency</p>
    <h1>Imperial HoloNet</h1>
    <p class="muted" style="max-width:62ch;">
      An encrypted Imperial broadcast. Power the console to receive synthesised
      fleet ambience, an Imperial march, and transmissions from Imperial Command.
      The HoloNet is monitored for the security of the Empire.
    </p>
  </section>

  <section class="section" style="margin-top:28px;">
    <RadioConsole />
  </section>
</Base>
