---
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import { fmtDate, langOf, lp, useT } from '../i18n';

const { entry } = Astro.props as { entry: any };
const lang = langOf(Astro.url.pathname);
const t = useT(lang);
const pt = lang === 'pt';
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} active="ai" description={d.summary}>
  <article class="article">
    <header class="article__head">
      <p class="kicker">{d.platform.toLowerCase()} · {d.track.toLowerCase()} · {d.level.toLowerCase()}</p>
      <h1>{d.title}</h1>
      <div class="article__meta">
        <span class={`badge badge--${d.severity.toLowerCase()}`}>{d.severity}</span>
        <span class="tag">{d.track}</span>
        <span class="tag">{fmtDate(d.date, lang)}</span>
      </div>
    </header>

    {pt && <p class="notice">{t('en.only')}</p>}

    <table class="specs">
      <tbody>
        <tr><th>{pt ? 'Alvo' : 'Target'}</th><td>{d.platform} · {pt ? `trilha ${d.track}` : `${d.track} track`} · {d.level}</td></tr>
        <tr><th>{pt ? 'Vulnerabilidade' : 'Vulnerability'}</th><td>{d.vuln}</td></tr>
        {d.owasp.length > 0 && <tr><th>OWASP LLM Top 10</th><td>{d.owasp.join(' · ')}</td></tr>}
        {d.atlas.length > 0 && <tr><th>MITRE ATLAS</th><td>{d.atlas.join(' · ')}</td></tr>}
        {d.flag && <tr><th>Flag</th><td><code>{d.flag}</code></td></tr>}
      </tbody>
    </table>

    <div class="prose" lang="en">
      {d.image && (
        <figure>
          <img src={d.image} alt={`${d.title}, solved`} loading="lazy" />
          <figcaption>{d.level}, {pt ? 'resolvido' : 'solved'}{d.flag && ` (${d.flag})`}</figcaption>
        </figure>
      )}
      <Content />
    </div>
    <p class="article__back"><a class="textlink" href={lp(lang, '/ai/')}>{t('back.ai')}</a></p>
  </article>
</Base>
