---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { byDateDesc } from '../lib/sortByDate';
import { fmtDate, langOf, lp } from '../i18n';

const lang = langOf(Astro.url.pathname);
const pt = lang === 'pt';
const articles = (await getCollection('articles', (e) => !e.data.draft)).sort(byDateDesc);
---
<Base
  title={pt ? 'Artigos' : 'Articles'}
  active="articles"
  description={pt ? 'Pesquisa em segurança, técnicas e notas sobre ferramentas.' : 'Security research, techniques and tooling notes.'}
>
  <header class="pagehead">
    <p class="kicker">ls articles/</p>
    {pt ? (
      <>
        <h1>Pesquisa e <em>artigos</em></h1>
        <p class="lede">Aprofundamentos em técnicas, análises de labs de certificação e notas sobre ferramentas. Os artigos estão em inglês.</p>
      </>
    ) : (
      <>
        <h1>Research &amp; <em>articles</em></h1>
        <p class="lede">Technique deep-dives, certification lab reviews and tooling notes.</p>
      </>
    )}
  </header>

  <div class="rows">
    {articles.map((a) => (
      <a class="row" href={lp(lang, `/articles/${a.id}/`)}>
        <span class="row__date">{fmtDate(a.data.date, lang)}</span>
        <div lang="en"><div class="row__title">{a.data.title}</div><p class="row__summary">{a.data.summary}</p></div>
        <div class="row__meta">{a.data.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}</div>
      </a>
    ))}
    {articles.length === 0 && <p class="empty">{pt ? 'Nenhum artigo ainda.' : 'No articles yet.'}</p>}
  </div>
</Base>
