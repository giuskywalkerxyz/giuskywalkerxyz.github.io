---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { byDateDesc } from '../lib/sortByDate';
import { langOf, lp } from '../i18n';

const lang = langOf(Astro.url.pathname);
const pt = lang === 'pt';
const cves = (await getCollection('cves', (e) => !e.data.draft)).sort(byDateDesc);
---
<Base
  title={pt ? 'Divulgações' : 'Disclosures'}
  active="cves"
  description={pt
    ? 'Vulnerabilidades encontradas e divulgadas de forma responsável em software open source.'
    : 'Vulnerabilities found and responsibly disclosed in open-source software.'}
>
  <header class="pagehead">
    <p class="kicker">cat disclosures.log</p>
    {pt ? (
      <>
        <h1>Vulnerabilidades <em>divulgadas</em></h1>
        <p class="lede">Vulnerabilidades que encontrei e reportei a mantenedores de projetos open source. Cada uma só é publicada depois que o advisory oficial sai.</p>
      </>
    ) : (
      <>
        <h1>Disclosed <em>vulnerabilities</em></h1>
        <p class="lede">Vulnerabilities I found and reported to open-source maintainers. Each entry is published only after the upstream advisory is public.</p>
      </>
    )}
  </header>

  <div class="rows">
    {cves.map((c) => (
      <a class="row" href={lp(lang, `/cves/${c.id}/`)}>
        <span class="row__date">{c.data.cve}</span>
        <div lang="en"><div class="row__title">{c.data.title}</div><p class="row__summary">{c.data.summary}</p></div>
        <div class="row__meta">
          <span class={`badge badge--${c.data.severity.toLowerCase()}`}>{c.data.severity}</span>
          <span class="tag">{c.data.vendor} / {c.data.product}</span>
          {c.data.cwe.slice(0, 1).map((w) => <span class="tag">{w}</span>)}
        </div>
      </a>
    ))}
    {cves.length === 0 && <p class="empty">{pt ? 'Advisories aguardando publicação.' : 'Advisories pending publication.'}</p>}
  </div>
</Base>
